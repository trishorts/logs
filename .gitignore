# /project — tracked vs ignored. Code worktrees + large data own their own remotes / are recorded.

# Source worktrees (push to their own forks; recorded in code/PINNED.md)
/code/*/
!/code/PINNED.md
!/code/reviews/
!/code/reviews/**

# Raw data & databases (recorded in data/PROVENANCE.md, not committed)
*.raw
*.mzML
*.mzml
*.d/
*.fasta
*.msl
*.db
/data/raw/
/data/**/*.raw
/data/**/*.mzML

# Quarantine
/.project/attic/

# Office lock files & build outputs
~$*
*.tmp
bin/
obj/
__pycache__/
.ipynb_checkpoints/

# Cross-project thread read-state: per-machine, not project truth (see references/threads.md)
.project/threads.state

# Pinned external reference data (Ensembl / Compara). Large; recorded in data/PROVENANCE.md.
/data/compara/
*.tsv.gz
*.gtf.gz
*.partial
# ...except the compact gene tables derived from those GTFs (~0.5 MB each; results/gene_sets/README.md).
!/results/gene_sets/*.genes.tsv.gz

# Scratch from the tests' __main__ runner
/tests/_tmp/

# Row-level search-DB resolution: regenerable with tools/ResolveSearchDb (~20 MB)
/results/search_db_*.tsv
